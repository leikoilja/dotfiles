{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": false
  },
  "prompt": {
    "editor": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
