{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode-go",
    // "opencode",
    "openai",
    // "github-copilot"
  ],
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@plannotator/opencode@latest",
    "@tarquinen/opencode-dcp@latest",
    "cc-safety-net",
    "opencode-gemini-auth@latest",
    "opencode-wakatime",
  ],
  "agent": {
    "build": {
      "permission": {
        "edit": "ask",
      },
    },
  },
}
